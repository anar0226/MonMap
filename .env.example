# Copy this file to .env and fill in your tokens.
# SECRETS (service-role key, etc.) go in .env.local — see bottom of file.

# ── Mapbox ───────────────────────────────────────────────────────────────────
# Secret token (sk.ey...) — used at build time to download the Mapbox SDK.
# Create at https://account.mapbox.com/tokens/ with Downloads:Read scope.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=sk.ey...

# Public token (pk.ey...) — used at runtime inside the app.
# Create at https://account.mapbox.com/tokens/ with Maps:Read + Styles:Read + Fonts:Read.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.ey...

# ── Supabase (public) ────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_URL=https://<project-ref>.supabase.co

# ── Google Places ────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIza...

# ── hCaptcha (auth abuse protection) ─────────────────────────────────────────
# The Supabase auth server is configured to require a captcha token on every
# auth call (see supabase/config.toml [auth.captcha]). Without this set, mobile
# auth (signUp, signInWithPassword, signInWithOtp) will fail.
#
# Provision at https://www.hcaptcha.com/ and copy the site key here. The
# matching secret must be set in Supabase dashboard → Auth → Bot/Abuse → hCaptcha.
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — put these in `.env.local`, NOT `.env`. `.env*.local` is gitignored
# and used by scripts/*.mjs (loadEnv reads both files; .env.local wins).
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=eyJ...    # bypasses RLS — only for /scripts/*.mjs
