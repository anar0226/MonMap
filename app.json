{
  "expo": {
    "name": "MonMap",
    "slug": "MonMap",
    "scheme": "monmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monmap.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MonMap uses your location to show you on the map and provide accurate ETAs.",
        "NSCameraUsageDescription": "Camera is used for AR indoor navigation to help you find your way inside buildings.",
        "LSApplicationQueriesSchemes": ["ubcab", "abataxi", "aba"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.monmap.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {}
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Camera is used for AR indoor navigation to help you find your way inside buildings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0053A3"
        }
      ]
    ]
  }
}
