{
  "expo": {
    "name": "MonMap",
    "slug": "MonMap",
    "scheme": "monmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monmap.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MonMap uses your location to detect when you're stopped in traffic so we can credit your wallet, place you on the map, and save your home and work locations.",
        "NSCameraUsageDescription": "MonMap uses the camera for AR indoor navigation so you can find your way inside buildings.",
        "NSPhotoLibraryUsageDescription": "MonMap uses your photo library only when you choose a profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "ubcab",
          "abataxi",
          "aba",
          "fb-messenger",
          "viber"
        ]
      }
    },
    "locales": {
      "mn": "./locales/ios/mn.json"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.monmap.myapp",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@rnmapbox/maps",
        {}
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MonMap uses the camera for AR indoor navigation so you can find your way inside buildings."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0053A3"
        }
      ],
      "./plugins/withAndroidLintConfig"
    ],
    "extra": {
      "eas": {
        "projectId": "23aa6235-b6b8-45f1-9e9d-ce5566b64684"
      }
    },
    "owner": "anarborgil"
  }
}
